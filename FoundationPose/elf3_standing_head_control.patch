+def validate_head_override_command(
+    names: Any,
+    pos: Any,
+    kp: Any,
+    kd: Any,
+    *,
+    vel: Any = (),
+    torque: Any = (),
+) -> tuple[str, ...]:
+    """Validate the hardware-facing external override before mailbox insertion.
+
+    The full-body and head-only controllers deliberately expose the same
+    override topic, but that topic is reserved for the two head joints in both
+    modes.  Keeping this check in the controller prevents a malformed or
+    unintended publisher from replacing a load-bearing body command.
+    """
+    command_names = tuple(names)
+    if not command_names:
+        raise ValueError("head override must contain at least one joint")
+    if any(not isinstance(name, str) or not name for name in command_names):
+        raise ValueError("head override joint names must be non-empty strings")
+    if len(set(command_names)) != len(command_names):
+        raise ValueError("head override contains duplicate joints")
+
+    unexpected = unexpected_head_only_override_joints(command_names)
+    if unexpected:
+        raise ValueError(
+            "head override rejects non-head joints: " + ", ".join(unexpected)
+        )
+
+    expected = len(command_names)
+
+    def values(field: str, raw: Any, *, empty_means_zero: bool = False):
+        sequence = tuple(raw)
+        if empty_means_zero and not sequence:
+            return (0.0,) * expected
+        if len(sequence) != expected:
+            raise ValueError(
+                f"head override {field} has length {len(sequence)}, "
+                f"expected {expected}"
+            )
+        try:
+            converted = tuple(float(value) for value in sequence)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(
+                f"head override {field} must contain numbers"
+            ) from exc
+        if not all(math.isfinite(value) for value in converted):
+            raise ValueError(
+                f"head override {field} must contain only finite values"
+            )
+        return converted
+
+    positions = values("pos", pos)
+    proportional = values("kp", kp)
+    derivative = values("kd", kd)
+    velocities = values("vel", vel, empty_means_zero=True)
+    torques = values("torque", torque, empty_means_zero=True)
+
+    for name, position in zip(command_names, positions):
+        limit = HEAD_OVERRIDE_POSITION_LIMITS[name]
+        if abs(position) > limit:
+            raise ValueError(
+                f"head override {name} position {position} exceeds +/-{limit} rad"
+            )
+    if any(value < 0.0 or value > HEAD_OVERRIDE_MAX_KP for value in proportional):
+        raise ValueError(
+            f"head override kp must be within [0, {HEAD_OVERRIDE_MAX_KP}]"
+        )
+    if any(value < 0.0 or value > HEAD_OVERRIDE_MAX_KD for value in derivative):
+        raise ValueError(
+            f"head override kd must be within [0, {HEAD_OVERRIDE_MAX_KD}]"
+        )
+    if any(value != 0.0 for value in velocities):
+        raise ValueError("head override velocity feed-forward must be zero")
+    if any(value != 0.0 for value in torques):
+        raise ValueError("head override torque feed-forward must be zero")
+    return command_names
+
