+HARDWARE_LOCK_FILE = "/tmp/bxi_example_hw.lock"
+_hardware_lock_fd: int | None = None
+
+
+def acquire_hardware_launch_lock() -> None:
+    """Hold the same system-wide lock used by the full hardware launch."""
+    global _hardware_lock_fd
+    if _hardware_lock_fd is not None:
+        return
+
+    old_umask = os.umask(0)
+    try:
+        try:
+            fd = os.open(HARDWARE_LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o666)
+        except PermissionError as exc:
+            print(
+                f"\n[ERROR] Cannot open lock file {HARDWARE_LOCK_FILE}: {exc}\n"
+                "        Remove a stale restrictive lock file, then retry:\n"
+                f"        sudo rm {HARDWARE_LOCK_FILE}\n",
+                file=sys.stderr,
+            )
+            raise SystemExit(1) from exc
+    finally:
+        os.umask(old_umask)
+
+    try:
+        os.chmod(HARDWARE_LOCK_FILE, 0o666)
+    except OSError:
+        pass
+
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except OSError as exc:
+        try:
+            os.lseek(fd, 0, os.SEEK_SET)
+            holder = (
+                os.read(fd, 64).decode("utf-8", errors="replace").strip()
+                or "unknown"
+            )
+        except OSError:
+            holder = "unknown"
+        os.close(fd)
+        print(
+            "\n[ERROR] BXI hardware is already running "
+            f"(launch pid={holder}). Stop it before starting another instance.\n",
+            file=sys.stderr,
+        )
+        raise SystemExit(1) from exc
+
+    os.ftruncate(fd, 0)
+    os.write(fd, str(os.getpid()).encode("utf-8"))
+    _hardware_lock_fd = fd
+
+    def release() -> None:
+        global _hardware_lock_fd
+        locked_fd = _hardware_lock_fd
+        if locked_fd is None:
+            return
+        _hardware_lock_fd = None
+        try:
+            fcntl.flock(locked_fd, fcntl.LOCK_UN)
+        except OSError:
+            pass
+        try:
+            os.close(locked_fd)
+        except OSError:
+            pass
+
+    atexit.register(release)
 
 
