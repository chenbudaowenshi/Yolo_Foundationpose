+# ELF3 publishes the 29 body joints first and the two head joints last.  The
+# vendor launch uses bits 29 and 30 (0x60000000) to disable the head.  The
+# complementary low 29 bits therefore disable the body for a head-only bench
+# test.  Keep these masks explicit: a wrong value can energise unintended
+# motors on real hardware.
+BODY_MOTOR_DISABLE_MASK = 0x1FFFFFFF
 HEAD_MOTOR_DISABLE_MASK = 0x60000000
