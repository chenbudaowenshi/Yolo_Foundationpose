+++ b/src/bxi_example_py_elf3/test/test_state_machine_export.py
@@ -0,0 +1,75 @@
+from bxi_example_py_elf3.framework.runtime.state_machine import RobotStateMachine
+
+
+class _Logger:
+    def __init__(self):
+        self.warnings = []
+
+    def warning(self, message):
+        self.warnings.append(message)
+
+
+def _machine():
+    machine = object.__new__(RobotStateMachine)
+    machine._logger = _Logger()
+    return machine
+
+
+def test_graph_export_uses_requested_path_when_writable():
+    machine = _machine()
+    writes = []
+    machine._write_graph_file = lambda path, content: writes.append((path, content))
+
+    machine._write_graph_export("/tmp/requested.dot", "graph")
+
+    assert writes == [("/tmp/requested.dot", "graph")]
+    assert machine._logger.warnings == []
+
+
+def test_graph_export_falls_back_to_process_scoped_tmp_path():
+    machine = _machine()
+    writes = []
+    fallback_writes = []
+
+    def write(path, content):
+        writes.append((path, content))
+        if path == "/tmp/root-owned.dot":
+            raise PermissionError("owned by another user")
+
+    machine._write_graph_file = write
+    machine._write_process_graph_file = lambda basename, content: (
+        fallback_writes.append((basename, content)) or "/tmp/secure-random.dot"
+    )
+    machine._write_graph_export("/tmp/root-owned.dot", "graph")
+
+    assert writes == [("/tmp/root-owned.dot", "graph")]
+    assert fallback_writes == [("root-owned.dot", "graph")]
+    assert len(machine._logger.warnings) == 1
+    assert "/tmp/secure-random.dot" in machine._logger.warnings[0]
+
+
+def test_graph_export_failure_is_nonfatal_when_fallback_also_fails():
+    machine = _machine()
+
+    def fail(_path, _content):
+        raise PermissionError("not writable")
+
+    machine._write_graph_file = fail
+    machine._write_process_graph_file = fail
+    machine._write_graph_export("/protected/state.mmd", "graph")
+
+    assert len(machine._logger.warnings) == 1
+    assert "export skipped" in machine._logger.warnings[0]
+
+
+def test_graph_file_replaces_symlink_instead_of_following_it(tmp_path):
+    victim = tmp_path / "victim.txt"
+    victim.write_text("do not overwrite", encoding="utf-8")
+    target = tmp_path / "state.dot"
+    target.symlink_to(victim)
+
+    RobotStateMachine._write_graph_file(str(target), "safe graph")
+
+    assert victim.read_text(encoding="utf-8") == "do not overwrite"
+    assert target.is_symlink() is False
+    assert target.read_text(encoding="utf-8") == "safe graph"
