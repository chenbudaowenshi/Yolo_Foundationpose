@@ -0,0 +1,1102 @@
+#!/usr/bin/python3
+"""ROS 2 keyboard controller for the two ELF3 head joints.
+
+This node follows the named-joint override interface implemented by
+``bxi_example_py_elf3/bxi_example_demo.py``.  It never imports MuJoCo and
+never writes simulator controls directly.
+
+Simulation example::
+
+    conda deactivate
+    source /opt/ros/humble/setup.bash
+    source /opt/bxi/bxi_ros2_pkg/setup.bash
+    source /path/to/bxi_rl_controller_ros2_example/install/setup.bash
+    ros2 run bxi_example_py_elf3 elf3_head_control
+
+Supported full-body standing example (only after the patched controller has
+been deployed while the robot was safely landed, and the running hardware
+node is ``hardware_elf3_head``)::
+
+    ros2 run bxi_example_py_elf3 elf3_head_control \
+        --hardware --standing-full-body --step-deg 2 --max-speed-deg 10 \
+        --yaw-limit-deg 15 --pitch-limit-deg 10 --duration 30
+
+This legacy compatibility package deliberately supports hardware only through
+``--standing-full-body``.  It keeps the body controller and remote link in
+charge while strictly verifying every ROS endpoint before publishing a head
+command.  It must never be paired with a head-only launch on a standing robot.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import select
+import signal
+import sys
+import termios
+import time
+import tty
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+
+ROBOT_NAME = "elf3"
+HEAD_YAW_JOINT = "head_z_joint"
+HEAD_PITCH_JOINT = "head_y_joint"
+HEAD_JOINT_NAMES = (HEAD_YAW_JOINT, HEAD_PITCH_JOINT)
+STANDING_HARDWARE_NODE = ("hardware_elf3_head", "/")
+STANDING_CONTROLLER_NODE = ("bxi_example_py_elf3_demo", "/")
+REMOTE_CONTROLLER_NODE = ("remote_controller", "/")
+
+FULL_BODY_STANDING_NODES = frozenset(
+    (STANDING_HARDWARE_NODE, STANDING_CONTROLLER_NODE, REMOTE_CONTROLLER_NODE)
+)
+FORBIDDEN_IN_STANDING_NODES = frozenset(
+    (
+        ("hardware_elf3_head_only", "/"),
+        ("bxi_example_py_elf3_head_only", "/"),
+        ("hardware_elf3", "/"),  # Vendor convention: head motors disabled.
+        ("bxi_example_py_elf3_mjlab", "/"),
+    )
+)
+
+# Limits from the ELF3 model in bxi_rl_controller_ros2_example.  The smaller
+# working limits leave a margin before the URDF hard stops.
+MECHANICAL_YAW_LIMIT = 1.57
+MECHANICAL_PITCH_LIMIT = 0.785
+FEEDBACK_LIMIT_TOLERANCE = 1.0e-3
+DEFAULT_YAW_LIMIT = math.radians(15.0)
+DEFAULT_PITCH_LIMIT = math.radians(10.0)
+
+DEFAULT_KP = 16.747
+DEFAULT_KD = 1.066
+DEFAULT_STEP = math.radians(2.0)
+DEFAULT_MAX_SPEED = math.radians(10.0)
+DEFAULT_PUBLISH_RATE = 50.0
+DEFAULT_FEEDBACK_TIMEOUT = 0.10
+
+KEY_HELP = """\
+ELF3 head controls (ROS 2 named-joint override):
+  Up / I       look up          Down / K     look down
+  Left / J     look left        Right / L    look right
+  C / Space    centre           R            release override
+  H / ?        show help        Q            quit
+"""
+
+ENVIRONMENT_HELP = """\
+Use the Ubuntu 22.04 system Python and source the ROS environments first:
+  conda deactivate
+  source /opt/ros/humble/setup.bash
+  source /opt/bxi/bxi_ros2_pkg/setup.bash
+  source /path/to/bxi_rl_controller_ros2_example/install/setup.bash
+  ros2 run bxi_example_py_elf3 elf3_head_control
+
+The BXI package supplies communication.msg.  If its setup.bash does not
+exist, install bxi_ros2_pkg as described in bxi_rl_controller_ros2_example/README.md,
+then run bash build.sh in bxi_rl_controller_ros2_example to create install/.
+"""
+
+
+class EnvironmentSetupError(RuntimeError):
+    """The active Python process cannot load the required ROS 2 packages."""
+
+
+def _finite(value: float, name: str) -> float:
+    value = float(value)
+    if not math.isfinite(value):
+        raise ValueError("{} must be finite".format(name))
+    return value
+
+
+def _clamp(value: float, lower: float, upper: float) -> float:
+    return max(lower, min(upper, value))
+
+
+def _limited_from_feedback(
+    measured: float,
+    target: float,
+    maximum_increment: float,
+    mechanical_limit: float,
+) -> float:
+    difference = _clamp(
+        target - measured,
+        -maximum_increment,
+        maximum_increment,
+    )
+    return _clamp(
+        measured + difference,
+        -mechanical_limit,
+        mechanical_limit,
+    )
+
+
+class HeadCommandState:
+    """ROS-independent head target and feedback watchdog state."""
+
+    def __init__(
+        self,
+        *,
+        yaw_limit: float,
+        pitch_limit: float,
+        key_step: float,
+        maximum_speed: float,
+        publish_rate: float,
+        feedback_timeout: float,
+        initial_yaw: Optional[float] = None,
+        initial_pitch: Optional[float] = None,
+    ) -> None:
+        self.yaw_limit = _finite(yaw_limit, "yaw limit")
+        self.pitch_limit = _finite(pitch_limit, "pitch limit")
+        self.key_step = _finite(key_step, "key step")
+        self.maximum_speed = _finite(maximum_speed, "maximum speed")
+        self.publish_rate = _finite(publish_rate, "publish rate")
+        self.feedback_timeout = _finite(
+            feedback_timeout, "feedback timeout"
+        )
+        if not 0.0 < self.yaw_limit <= MECHANICAL_YAW_LIMIT:
+            raise ValueError("yaw limit is outside the ELF3 mechanical limit")
+        if not 0.0 < self.pitch_limit <= MECHANICAL_PITCH_LIMIT:
+            raise ValueError("pitch limit is outside the ELF3 mechanical limit")
+        if self.key_step <= 0.0:
+            raise ValueError("key step must be positive")
+        if self.maximum_speed <= 0.0:
+            raise ValueError("maximum speed must be positive")
+        if self.publish_rate <= 0.0:
+            raise ValueError("publish rate must be positive")
+        if self.feedback_timeout <= 0.0:
+            raise ValueError("feedback timeout must be positive")
+
+        self.initial_yaw = (
+            None if initial_yaw is None else _finite(initial_yaw, "initial yaw")
+        )
+        self.initial_pitch = (
+            None
+            if initial_pitch is None
+            else _finite(initial_pitch, "initial pitch")
+        )
+        if self.initial_yaw is not None and abs(self.initial_yaw) > self.yaw_limit:
+            raise ValueError("initial yaw exceeds the configured working limit")
+        if (
+            self.initial_pitch is not None
+            and abs(self.initial_pitch) > self.pitch_limit
+        ):
+            raise ValueError("initial pitch exceeds the configured working limit")
+
+        self.feedback_received = False
+        self.last_feedback_at = float("-inf")
+        self.measured_yaw = 0.0
+        self.measured_pitch = 0.0
+        self.target_yaw = 0.0
+        self.target_pitch = 0.0
+        self.active = False
+
+    @property
+    def maximum_increment(self) -> float:
+        return self.maximum_speed / self.publish_rate
+
+    def update_feedback(
+        self,
+        names: Sequence[str],
+        positions: Sequence[float],
+        now: float,
+    ) -> bool:
+        """Store named feedback; return True only on first valid update."""
+        timestamp = _finite(now, "feedback timestamp")
+        if len(names) != len(positions):
+            raise ValueError(
+                "actuator state name/position lengths differ: {} != {}".format(
+                    len(names), len(positions)
+                )
+            )
+
+        head_positions: Dict[str, float] = {}
+        for name, position in zip(names, positions):
+            if name in HEAD_JOINT_NAMES:
+                if name in head_positions:
+                    raise ValueError(
+                        "actuator state contains duplicate head joint: {}".format(
+                            name
+                        )
+                    )
+                head_positions[name] = _finite(
+                    position, "{} position".format(name)
+                )
+        missing = [name for name in HEAD_JOINT_NAMES if name not in head_positions]
+        if missing:
+            raise ValueError(
+                "actuator state does not contain head joints: {}".format(
+                    ", ".join(missing)
+                )
+            )
+
+        raw_yaw = head_positions[HEAD_YAW_JOINT]
+        raw_pitch = head_positions[HEAD_PITCH_JOINT]
+        if abs(raw_yaw) > MECHANICAL_YAW_LIMIT + FEEDBACK_LIMIT_TOLERANCE:
+            raise ValueError(
+                "{} feedback {:+.4f} rad exceeds mechanical limit".format(
+                    HEAD_YAW_JOINT, raw_yaw
+                )
+            )
+        if abs(raw_pitch) > MECHANICAL_PITCH_LIMIT + FEEDBACK_LIMIT_TOLERANCE:
+            raise ValueError(
+                "{} feedback {:+.4f} rad exceeds mechanical limit".format(
+                    HEAD_PITCH_JOINT, raw_pitch
+                )
+            )
+
+        yaw = _clamp(
+            raw_yaw,
+            -MECHANICAL_YAW_LIMIT,
+            MECHANICAL_YAW_LIMIT,
+        )
+        pitch = _clamp(
+            raw_pitch,
+            -MECHANICAL_PITCH_LIMIT,
+            MECHANICAL_PITCH_LIMIT,
+        )
+        first = not self.feedback_received
+        self.feedback_received = True
+        self.last_feedback_at = timestamp
+        self.measured_yaw = yaw
+        self.measured_pitch = pitch
+
+        if first:
+            self.target_yaw = (
+                _clamp(yaw, -self.yaw_limit, self.yaw_limit)
+                if self.initial_yaw is None
+                else self.initial_yaw
+            )
+            self.target_pitch = (
+                _clamp(pitch, -self.pitch_limit, self.pitch_limit)
+                if self.initial_pitch is None
+                else self.initial_pitch
+            )
+            # Merely starting the node must not seize the head.  Keyboard
+            # input activates it; an explicit CLI target opts into startup.
+            self.active = (
+                self.initial_yaw is not None or self.initial_pitch is not None
+            )
+        return first
+
+    def feedback_is_fresh(self, now: float) -> bool:
+        return self.feedback_received and (
+            _finite(now, "current timestamp") - self.last_feedback_at
+            <= self.feedback_timeout
+        )
+
+    def release(self) -> bool:
+        """Deactivate once; True means one empty ROS message must be sent."""
+        if not self.active:
+            return False
+        self.active = False
+        if self.feedback_received:
+            self.target_yaw = _clamp(
+                self.measured_yaw, -self.yaw_limit, self.yaw_limit
+            )
+            self.target_pitch = _clamp(
+                self.measured_pitch, -self.pitch_limit, self.pitch_limit
+            )
+        return True
+
+    def apply_action(self, action: str, now: float) -> str:
+        """Apply a keyboard action and report active/waiting/released."""
+        if action == "release":
+            return "released" if self.release() else "inactive"
+        if not self.feedback_is_fresh(now):
+            return "waiting"
+
+        # Reacquisition always starts from current measured feedback.  This
+        # avoids jumping back to a target retained before an explicit release.
+        if not self.active:
+            self.target_yaw = _clamp(
+                self.measured_yaw, -self.yaw_limit, self.yaw_limit
+            )
+            self.target_pitch = _clamp(
+                self.measured_pitch, -self.pitch_limit, self.pitch_limit
+            )
+            self.active = True
+
+        if action == "left":
+            self.target_yaw += self.key_step
+        elif action == "right":
+            self.target_yaw -= self.key_step
+        elif action == "up":
+            self.target_pitch -= self.key_step
+        elif action == "down":
+            self.target_pitch += self.key_step
+        elif action == "centre":
+            self.target_yaw = 0.0
+            self.target_pitch = 0.0
+        else:
+            raise ValueError("unknown head action: {}".format(action))
+
+        self.target_yaw = _clamp(
+            self.target_yaw, -self.yaw_limit, self.yaw_limit
+        )
+        self.target_pitch = _clamp(
+            self.target_pitch, -self.pitch_limit, self.pitch_limit
+        )
+        return "active"
+
+    def next_command(self, now: float) -> Optional[Tuple[float, float]]:
+        """Return one feedback-relative, speed-limited yaw/pitch command."""
+        if not self.active or not self.feedback_is_fresh(now):
+            return None
+        increment = self.maximum_increment
+        return (
+            _limited_from_feedback(
+                self.measured_yaw,
+                self.target_yaw,
+                increment,
+                MECHANICAL_YAW_LIMIT,
+            ),
+            _limited_from_feedback(
+                self.measured_pitch,
+                self.target_pitch,
+                increment,
+                MECHANICAL_PITCH_LIMIT,
+            ),
+        )
+
+
+_ESCAPE_ACTIONS = {
+    b"\x1b[A": "up",
+    b"\x1b[B": "down",
+    b"\x1b[C": "right",
+    b"\x1b[D": "left",
+}
+_BYTE_ACTIONS = {
+    b"i": "up",
+    b"I": "up",
+    b"k": "down",
+    b"K": "down",
+    b"j": "left",
+    b"J": "left",
+    b"l": "right",
+    b"L": "right",
+    b"c": "centre",
+    b"C": "centre",
+    b" ": "centre",
+    b"r": "release",
+    b"R": "release",
+    b"h": "help",
+    b"H": "help",
+    b"?": "help",
+    b"q": "quit",
+    b"Q": "quit",
+}
+
+
+class KeyboardReader:
+    """Non-blocking POSIX keyboard reader that restores terminal settings."""
+
+    def __init__(self, stream: Any = None) -> None:
+        self.stream = sys.stdin if stream is None else stream
+        self.fd: Optional[int] = None
+        self.saved_attributes: Any = None
+        self.buffer = b""
+
+    def __enter__(self):
+        if not hasattr(self.stream, "fileno"):
+            raise RuntimeError("standard input has no file descriptor")
+        self.fd = int(self.stream.fileno())
+        if not os.isatty(self.fd):
+            raise RuntimeError(
+                "keyboard control needs a terminal; use --no-keyboard for a ROS-only node"
+            )
+        self.saved_attributes = termios.tcgetattr(self.fd)
+        tty.setcbreak(self.fd)
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        if self.fd is not None and self.saved_attributes is not None:
+            termios.tcsetattr(
+                self.fd,
+                termios.TCSADRAIN,
+                self.saved_attributes,
+            )
+
+    def poll(self) -> List[str]:
+        if self.fd is None:
+            return []
+        while True:
+            readable, _, _ = select.select([self.fd], [], [], 0.0)
+            if not readable:
+                break
+            chunk = os.read(self.fd, 64)
+            if not chunk:
+                break
+            self.buffer += chunk
+
+        actions: List[str] = []
+        while self.buffer:
+            matched = False
+            for sequence, action in _ESCAPE_ACTIONS.items():
+                if self.buffer.startswith(sequence):
+                    actions.append(action)
+                    self.buffer = self.buffer[len(sequence) :]
+                    matched = True
+                    break
+            if matched:
+                continue
+            if any(sequence.startswith(self.buffer) for sequence in _ESCAPE_ACTIONS):
+                break
+            first = self.buffer[:1]
+            self.buffer = self.buffer[1:]
+            action = _BYTE_ACTIONS.get(first)
+            if action is not None:
+                actions.append(action)
+        return actions
+
+
+def _load_ros_modules():
+    if sys.version_info[:2] != (3, 10):
+        raise EnvironmentSetupError(
+            "Active Python is {}.{}; ROS 2 Humble on Ubuntu 22.04 uses Python 3.10.\n\n{}".format(
+                sys.version_info[0], sys.version_info[1], ENVIRONMENT_HELP
+            )
+        )
+
+    try:
+        import rclpy
+        from rclpy.node import Node
+        from rclpy.qos import QoSProfile, qos_profile_sensor_data
+        from rclpy.signals import SignalHandlerOptions
+    except Exception as error:
+        raise EnvironmentSetupError(
+            "Cannot import ROS 2 rclpy: {}\n\n{}".format(error, ENVIRONMENT_HELP)
+        ) from error
+
+    try:
+        from communication.msg import ActuatorCmds, ActuatorStates
+    except Exception as error:
+        raise EnvironmentSetupError(
+            "Cannot import BXI communication.msg: {}\n\n{}".format(
+                error, ENVIRONMENT_HELP
+            )
+        ) from error
+
+    return (
+        rclpy,
+        Node,
+        QoSProfile,
+        qos_profile_sensor_data,
+        SignalHandlerOptions,
+        ActuatorCmds,
+        ActuatorStates,
+    )
+
+
+def _populate_command_message(
+    message: Any,
+    *,
+    stamp: Any,
+    yaw: float,
+    pitch: float,
+) -> Any:
+    message.header.frame_id = ROBOT_NAME
+    message.header.stamp = stamp
+    message.actuators_name = list(HEAD_JOINT_NAMES)
+    message.pos = [float(yaw), float(pitch)]
+    message.vel = [0.0, 0.0]
+    message.torque = [0.0, 0.0]
+    message.kp = [DEFAULT_KP, DEFAULT_KP]
+    message.kd = [DEFAULT_KD, DEFAULT_KD]
+    return message
+
+
+def _populate_release_message(message: Any, *, stamp: Any) -> Any:
+    message.header.frame_id = ROBOT_NAME
+    message.header.stamp = stamp
+    message.actuators_name = []
+    message.pos = []
+    message.vel = []
+    message.torque = []
+    message.kp = []
+    message.kd = []
+    return message
+
+
+def _make_node_class(
+    Node: Any,
+    QoSProfile: Any,
+    qos_profile_sensor_data: Any,
+    ActuatorCmds: Any,
+    ActuatorStates: Any,
+):
+    class RosHeadControlNode(Node):
+        def __init__(self, args: argparse.Namespace) -> None:
+            super().__init__("elf3_head_control")
+            self.topic_prefix = "hardware/" if args.hardware else "simulation/"
+            self.command_topic = self.topic_prefix + "actuators_cmds_override"
+            self.feedback_topic = self.topic_prefix + "actuator_states"
+            self.primary_command_topic = self.topic_prefix + "actuators_cmds"
+            self.state_machine_info_topic = (
+                self.topic_prefix + "state_machine_info"
+            )
+            self.motion_command_topic = "motion_commands"
+            self.state = HeadCommandState(
+                yaw_limit=math.radians(args.yaw_limit_deg),
+                pitch_limit=math.radians(args.pitch_limit_deg),
+                key_step=math.radians(args.step_deg),
+                maximum_speed=math.radians(args.max_speed_deg),
+                publish_rate=args.rate,
+                feedback_timeout=args.feedback_timeout,
+                initial_yaw=(
+                    None if args.yaw_deg is None else math.radians(args.yaw_deg)
+                ),
+                initial_pitch=(
+                    None
+                    if args.pitch_deg is None
+                    else math.radians(args.pitch_deg)
+                ),
+            )
+            qos = QoSProfile(
+                depth=1,
+                durability=qos_profile_sensor_data.durability,
+                reliability=qos_profile_sensor_data.reliability,
+            )
+            self.command_publisher = self.create_publisher(
+                ActuatorCmds,
+                self.command_topic,
+                qos,
+            )
+            self.feedback_subscription = self.create_subscription(
+                ActuatorStates,
+                self.feedback_topic,
+                self._feedback_callback,
+                qos,
+            )
+            self.publish_timer = self.create_timer(
+                1.0 / args.rate,
+                self._publish_timer_callback,
+            )
+            self.quit_requested = False
+            self.started_at = time.monotonic()
+            self.last_wait_warning_at = float("-inf")
+            self.last_bad_feedback_warning_at = float("-inf")
+            self.last_no_consumer_warning_at = float("-inf")
+            self.stale_feedback_warned = False
+            self.publisher_conflict_detected = False
+            self.require_hardware_graph = bool(args.hardware)
+            self.full_body_standing_mode = bool(
+                args.hardware and getattr(args, "allow_full_hardware", False)
+            )
+            self.last_hardware_mode_warning_at = float("-inf")
+            self.hardware_graph_verified = False
+
+            self.get_logger().info(
+                "ELF3 ROS head controller ready: feedback=/{} override=/{}".format(
+                    self.feedback_topic,
+                    self.command_topic,
+                )
+            )
+            if self.full_body_standing_mode:
+                self.get_logger().warning(
+                    "FULL-BODY STANDING MODE: the body controller remains active; "
+                    "keep the remote at zero velocity, use a rated support, and "
+                    "keep the emergency stop accessible"
+                )
+
+        @staticmethod
+        def _endpoint_owners(endpoint_info: Sequence[Any]) -> set:
+            owners = set()
+            for endpoint in endpoint_info:
+                namespace = endpoint.node_namespace or "/"
+                owners.add((endpoint.node_name, namespace))
+            return owners
+
+        @staticmethod
+        def _qualified_node_name(owner: Tuple[str, str]) -> str:
+            name, namespace = owner
+            return "{}/{}".format(namespace.rstrip("/"), name).replace("//", "/")
+
+        @classmethod
+        def _endpoint_status(
+            cls,
+            label: str,
+            endpoint_info: Sequence[Any],
+            expected_owner: Tuple[str, str],
+        ) -> Tuple[bool, str]:
+            owners = cls._endpoint_owners(endpoint_info)
+            expected = {expected_owner}
+            if len(endpoint_info) != 1 or owners != expected:
+                found = ", ".join(
+                    sorted(cls._qualified_node_name(owner) for owner in owners)
+                ) or "none"
+                expected_name = cls._qualified_node_name(expected_owner)
+                return False, "{} must belong only to {}; found {}".format(
+                    label,
+                    expected_name,
+                    found,
+                )
+            return True, ""
+
+        def _hardware_graph_status(self) -> Tuple[bool, str]:
+            required = FULL_BODY_STANDING_NODES
+            forbidden_nodes = FORBIDDEN_IN_STANDING_NODES
+            hardware_owner = STANDING_HARDWARE_NODE
+            controller_owner = STANDING_CONTROLLER_NODE
+            verified_detail = "head-enabled full-body ROS graph verified"
+
+            visible = set(self.get_node_names_and_namespaces())
+            missing = required - visible
+            if missing:
+                names = ", ".join(
+                    sorted(self._qualified_node_name(owner) for owner in missing)
+                )
+                return False, "required hardware nodes are not visible: {}".format(names)
+            forbidden = forbidden_nodes & visible
+            if forbidden:
+                names = ", ".join(sorted(name for name, _namespace in forbidden))
+                return False, "incompatible hardware nodes are present: {}".format(names)
+
+            endpoint_checks = (
+                (
+                    "hardware feedback publisher",
+                    self.get_publishers_info_by_topic(self.feedback_topic),
+                    hardware_owner,
+                ),
+                (
+                    "primary command publisher",
+                    self.get_publishers_info_by_topic(self.primary_command_topic),
+                    controller_owner,
+                ),
+                (
+                    "hardware command subscriber",
+                    self.get_subscriptions_info_by_topic(
+                        self.primary_command_topic
+                    ),
+                    hardware_owner,
+                ),
+                (
+                    "override subscriber",
+                    self.get_subscriptions_info_by_topic(self.command_topic),
+                    controller_owner,
+                ),
+            )
+            for label, endpoints, owner in endpoint_checks:
+                ready, detail = self._endpoint_status(label, endpoints, owner)
+                if not ready:
+                    return False, detail
+
+            standing_checks = (
+                (
+                    "state-machine status publisher",
+                    self.get_publishers_info_by_topic(
+                        self.state_machine_info_topic
+                    ),
+                    STANDING_CONTROLLER_NODE,
+                ),
+                (
+                    "remote motion publisher",
+                    self.get_publishers_info_by_topic(self.motion_command_topic),
+                    REMOTE_CONTROLLER_NODE,
+                ),
+                (
+                    "controller motion subscriber",
+                    self.get_subscriptions_info_by_topic(
+                        self.motion_command_topic
+                    ),
+                    STANDING_CONTROLLER_NODE,
+                ),
+            )
+            for label, endpoints, owner in standing_checks:
+                ready, detail = self._endpoint_status(label, endpoints, owner)
+                if not ready:
+                    return False, detail
+
+            return True, verified_detail
+
+        def _feedback_callback(self, message: Any) -> None:
+            now = time.monotonic()
+            try:
+                first = self.state.update_feedback(
+                    message.name,
+                    message.position,
+                    now,
+                )
+            except (TypeError, ValueError) as error:
+                if now - self.last_bad_feedback_warning_at >= 2.0:
+                    self.get_logger().warning(
+                        "head feedback is not usable: {}".format(error)
+                    )
+                    self.last_bad_feedback_warning_at = now
+                self.release_override("invalid head feedback")
+                return
+
+            if first:
+                self.get_logger().info(
+                    "head feedback acquired: yaw={:+.2f} deg, pitch={:+.2f} deg".format(
+                        math.degrees(self.state.measured_yaw),
+                        math.degrees(self.state.measured_pitch),
+                    )
+                )
+                if not self.state.active:
+                    self.get_logger().info(
+                        "press a direction key or C to activate the head override"
+                    )
+            elif self.stale_feedback_warned:
+                self.get_logger().info(
+                    "head feedback recovered; press a direction key or C to reacquire"
+                )
+                self.stale_feedback_warned = False
+
+        def _publish_timer_callback(self) -> None:
+            now = time.monotonic()
+            if self.count_publishers(self.command_topic) > 1:
+                if not self.publisher_conflict_detected:
+                    self.get_logger().error(
+                        "another publisher is using /{}; stopping this node to "
+                        "avoid conflicting head commands".format(self.command_topic)
+                    )
+                    self.publisher_conflict_detected = True
+                # Do not publish a clear message here: it would also clear the
+                # other controller's newest command.  Our last sample expires
+                # through the example controller's 0.2 s ingress timeout.
+                self.state.release()
+                self.quit_requested = True
+                return
+
+            if self.require_hardware_graph:
+                hardware_ready, hardware_detail = self._hardware_graph_status()
+                if not hardware_ready:
+                    self.hardware_graph_verified = False
+                    if self.state.active:
+                        self.release_override("verified hardware graph disappeared")
+                    if now - self.last_hardware_mode_warning_at >= 2.0:
+                        self.get_logger().warning(
+                            "hardware safety gate is closed: {}".format(
+                                hardware_detail
+                            )
+                        )
+                        self.last_hardware_mode_warning_at = now
+                    return
+                if not self.hardware_graph_verified:
+                    self.get_logger().info(
+                        "{}; keyboard control is enabled".format(hardware_detail)
+                    )
+                    self.hardware_graph_verified = True
+
+            if not self.state.feedback_received:
+                if now - self.last_wait_warning_at >= 2.0:
+                    self.get_logger().warning(
+                        "waiting for both head joints on /{}".format(
+                            self.feedback_topic
+                        )
+                    )
+                    self.last_wait_warning_at = now
+                return
+
+            if not self.state.feedback_is_fresh(now):
+                if self.release_override("head feedback timed out"):
+                    self.stale_feedback_warned = True
+                return
+
+            if (
+                self.command_publisher.get_subscription_count() == 0
+                and now - self.started_at >= 2.0
+                and now - self.last_no_consumer_warning_at >= 5.0
+            ):
+                self.get_logger().warning(
+                    "no subscriber on /{}; start the bxi_example_demo controller "
+                    "from this example repository".format(self.command_topic)
+                )
+                self.last_no_consumer_warning_at = now
+
+            command = self.state.next_command(now)
+            if command is None:
+                return
+            message = _populate_command_message(
+                ActuatorCmds(),
+                stamp=self.get_clock().now().to_msg(),
+                yaw=command[0],
+                pitch=command[1],
+            )
+            self.command_publisher.publish(message)
+
+        def release_override(self, reason: str) -> bool:
+            """Publish exactly one clear message for the active generation."""
+            if self.count_publishers(self.command_topic) > 1:
+                was_active = self.state.release()
+                if was_active:
+                    self.get_logger().warning(
+                        "head override abandoned without publishing clear because "
+                        "another publisher is using /{}".format(self.command_topic)
+                    )
+                return False
+            if not self.state.release():
+                return False
+            message = _populate_release_message(
+                ActuatorCmds(),
+                stamp=self.get_clock().now().to_msg(),
+            )
+            self.command_publisher.publish(message)
+            self.get_logger().info("head override released: {}".format(reason))
+            return True
+
+        def handle_action(self, action: str) -> None:
+            if action == "help":
+                print("\n" + KEY_HELP, flush=True)
+                return
+            if action == "quit":
+                self.quit_requested = True
+                return
+            if action == "release":
+                self.release_override("keyboard request")
+                return
+
+            result = self.state.apply_action(action, time.monotonic())
+            if result == "waiting":
+                self.get_logger().warning(
+                    "cannot move the head until fresh joint feedback is available"
+                )
+                return
+            self.get_logger().info(
+                "head target: yaw={:+.1f} deg, pitch={:+.1f} deg".format(
+                    math.degrees(self.state.target_yaw),
+                    math.degrees(self.state.target_pitch),
+                )
+            )
+
+    return RosHeadControlNode
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Control ELF3 head_y/head_z through the ROS 2 named-joint override"
+        )
+    )
+    parser.add_argument(
+        "--hardware",
+        action="store_true",
+        help="use hardware/ topics (default is the safer simulation/ topics)",
+    )
+    parser.add_argument(
+        "--standing-full-body",
+        "--allow-full-hardware",
+        dest="allow_full_hardware",
+        action="store_true",
+        help=(
+            "keep a patched, head-enabled full-body controller active while "
+            "strictly verifying its ROS graph (advanced supported test only)"
+        ),
+    )
+    parser.add_argument(
+        "--yaw-deg",
+        type=float,
+        default=None,
+        help="optional initial yaw target; positive looks left",
+    )
+    parser.add_argument(
+        "--pitch-deg",
+        type=float,
+        default=None,
+        help="optional initial pitch target; negative looks up",
+    )
+    parser.add_argument(
+        "--step-deg",
+        type=float,
+        default=math.degrees(DEFAULT_STEP),
+        help="target change per key press (default: 2 degrees)",
+    )
+    parser.add_argument(
+        "--max-speed-deg",
+        type=float,
+        default=math.degrees(DEFAULT_MAX_SPEED),
+        help="maximum feedback-relative target speed (default: 10 deg/s)",
+    )
+    parser.add_argument(
+        "--yaw-limit-deg",
+        type=float,
+        default=math.degrees(DEFAULT_YAW_LIMIT),
+        help="working yaw limit (default: 15 degrees)",
+    )
+    parser.add_argument(
+        "--pitch-limit-deg",
+        type=float,
+        default=math.degrees(DEFAULT_PITCH_LIMIT),
+        help="working pitch limit (default: 10 degrees)",
+    )
+    parser.add_argument(
+        "--rate",
+        type=float,
+        default=DEFAULT_PUBLISH_RATE,
+        help="override publication rate in Hz (default: 50)",
+    )
+    parser.add_argument(
+        "--feedback-timeout",
+        type=float,
+        default=DEFAULT_FEEDBACK_TIMEOUT,
+        help="release when feedback is older than this many seconds (default: 0.10)",
+    )
+    parser.add_argument(
+        "--no-keyboard",
+        action="store_true",
+        help="run without reading stdin (useful with --yaw-deg/--pitch-deg)",
+    )
+    parser.add_argument(
+        "--duration",
+        type=float,
+        default=None,
+        help="quit and release after this many seconds",
+    )
+    return parser
+
+
+def validate_args(
+    args: argparse.Namespace,
+    parser: argparse.ArgumentParser,
+) -> None:
+    if args.allow_full_hardware and not args.hardware:
+        parser.error("--standing-full-body requires --hardware")
+    if args.hardware and not args.allow_full_hardware:
+        parser.error(
+            "hardware control in this legacy package requires "
+            "--standing-full-body"
+        )
+    if (
+        args.hardware
+        and (args.yaw_deg is not None or args.pitch_deg is not None)
+    ):
+        parser.error(
+            "automatic --yaw-deg/--pitch-deg targets are disabled for the "
+            "hardware safety modes"
+        )
+
+    values = (
+        ("--step-deg", args.step_deg),
+        ("--max-speed-deg", args.max_speed_deg),
+        ("--yaw-limit-deg", args.yaw_limit_deg),
+        ("--pitch-limit-deg", args.pitch_limit_deg),
+        ("--rate", args.rate),
+        ("--feedback-timeout", args.feedback_timeout),
+    )
+    for name, value in values:
+        if not math.isfinite(value) or value <= 0.0:
+            parser.error("{} must be positive and finite".format(name))
+    for name, value in (("--yaw-deg", args.yaw_deg), ("--pitch-deg", args.pitch_deg)):
+        if value is not None and not math.isfinite(value):
+            parser.error("{} must be finite".format(name))
+
+    if args.step_deg > 20.0:
+        parser.error("--step-deg cannot exceed 20")
+    if args.max_speed_deg > 10.0:
+        parser.error("--max-speed-deg cannot exceed the server limit of 10")
+    if not 20.0 <= args.rate <= 100.0:
+        parser.error("--rate must be between 20 and 100 Hz")
+    if args.feedback_timeout > 0.15:
+        parser.error("--feedback-timeout cannot exceed 0.15 s")
+    if args.yaw_limit_deg > math.degrees(MECHANICAL_YAW_LIMIT):
+        parser.error("--yaw-limit-deg exceeds the ELF3 model limit")
+    if args.pitch_limit_deg > math.degrees(MECHANICAL_PITCH_LIMIT):
+        parser.error("--pitch-limit-deg exceeds the ELF3 model limit")
+    if args.yaw_deg is not None and abs(args.yaw_deg) > args.yaw_limit_deg:
+        parser.error("--yaw-deg exceeds --yaw-limit-deg")
+    if args.pitch_deg is not None and abs(args.pitch_deg) > args.pitch_limit_deg:
+        parser.error("--pitch-deg exceeds --pitch-limit-deg")
+    if args.duration is not None and (
+        not math.isfinite(args.duration) or args.duration <= 0.0
+    ):
+        parser.error("--duration must be positive and finite")
+
+
+def _run_loop(
+    rclpy: Any,
+    node: Any,
+    keyboard: Optional[KeyboardReader],
+    duration: Optional[float],
+) -> None:
+    started_at = time.monotonic()
+    while rclpy.ok() and not node.quit_requested:
+        rclpy.spin_once(node, timeout_sec=0.02)
+        if keyboard is not None:
+            for action in keyboard.poll():
+                node.handle_action(action)
+        if duration is not None and time.monotonic() - started_at >= duration:
+            node.quit_requested = True
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    validate_args(args, parser)
+
+    try:
+        (
+            rclpy,
+            Node,
+            QoSProfile,
+            qos_profile_sensor_data,
+            SignalHandlerOptions,
+            ActuatorCmds,
+            ActuatorStates,
+        ) = _load_ros_modules()
+    except EnvironmentSetupError as error:
+        print("ERROR: {}".format(error), file=sys.stderr)
+        return 2
+
+    RosHeadControlNode = _make_node_class(
+        Node,
+        QoSProfile,
+        qos_profile_sensor_data,
+        ActuatorCmds,
+        ActuatorStates,
+    )
+
+    node = None
+    stop_requested = {"value": False}
+
+    def request_stop(signum, frame) -> None:
+        del signum, frame
+        stop_requested["value"] = True
+        if node is not None:
+            node.quit_requested = True
+
+    old_sigint = signal.signal(signal.SIGINT, request_stop)
+    old_sigterm = signal.signal(signal.SIGTERM, request_stop)
+    ros_initialized = False
+    exit_code = 0
+    try:
+        rclpy.init(args=None, signal_handler_options=SignalHandlerOptions.NO)
+        ros_initialized = True
+        node = RosHeadControlNode(args)
+        if not args.no_keyboard:
+            print(KEY_HELP, flush=True)
+            with KeyboardReader() as keyboard:
+                _run_loop(rclpy, node, keyboard, args.duration)
+        else:
+            _run_loop(rclpy, node, None, args.duration)
+    except KeyboardInterrupt:
+        stop_requested["value"] = True
+    except RuntimeError as error:
+        print("ERROR: {}".format(error), file=sys.stderr)
+        exit_code = 1
+    finally:
+        if node is not None:
+            try:
+                released = node.release_override("node shutdown")
+                if released and rclpy.ok():
+                    # Keep the context alive briefly so the single clear sample
+                    # reaches DDS.  The controller's 0.2 s timeout is fallback.
+                    rclpy.spin_once(node, timeout_sec=0.05)
+            except Exception as error:
+                print(
+                    "WARNING: could not publish final head release: {}".format(error),
+                    file=sys.stderr,
+                )
+            node.destroy_node()
+        if ros_initialized and rclpy.ok():
+            rclpy.shutdown()
+        signal.signal(signal.SIGINT, old_sigint)
+        signal.signal(signal.SIGTERM, old_sigterm)
+
+    if stop_requested["value"]:
+        print("Head controller stopped; override released.")
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
