@@ -0,0 +1,71 @@
+from types import SimpleNamespace
+
+from bxi_example_py_elf3.utils.state_machine import RobotStateMachine
+
+
+class _Logger:
+    def __init__(self):
+        self.warnings = []
+
+    def warning(self, message):
+        self.warnings.append(message)
+
+
+def _machine():
+    machine = object.__new__(RobotStateMachine)
+    logger = _Logger()
+    machine._ctx = SimpleNamespace(get_logger=lambda: logger)
+    return machine, logger
+
+
+def test_graph_export_uses_requested_path_when_writable():
+    machine, logger = _machine()
+    writes = []
+    machine._write_graph_file = lambda path, content: writes.append((path, content))
+
+    machine._write_text("/tmp/requested.dot", "graph")
+
+    assert writes == [("/tmp/requested.dot", "graph")]
+    assert logger.warnings == []
+
+
+def test_graph_export_falls_back_without_stopping_controller():
+    machine, logger = _machine()
+    machine._write_graph_file = lambda _path, _content: (_ for _ in ()).throw(
+        PermissionError("root-owned")
+    )
+    machine._write_process_graph_file = (
+        lambda _basename, _content: "/tmp/secure-random.dot"
+    )
+
+    machine._write_text("/tmp/root-owned.dot", "graph")
+
+    assert len(logger.warnings) == 1
+    assert "/tmp/secure-random.dot" in logger.warnings[0]
+
+
+def test_graph_export_double_failure_is_nonfatal():
+    machine, logger = _machine()
+
+    def fail(_path, _content):
+        raise PermissionError("not writable")
+
+    machine._write_graph_file = fail
+    machine._write_process_graph_file = fail
+    machine._write_text("/protected/state.dot", "graph")
+
+    assert len(logger.warnings) == 1
+    assert "export skipped" in logger.warnings[0]
+
+
+def test_graph_file_replaces_symlink_without_following_it(tmp_path):
+    victim = tmp_path / "victim"
+    victim.write_text("keep", encoding="utf-8")
+    target = tmp_path / "state.dot"
+    target.symlink_to(victim)
+
+    RobotStateMachine._write_graph_file(str(target), "safe")
+
+    assert victim.read_text(encoding="utf-8") == "keep"
+    assert target.is_symlink() is False
+    assert target.read_text(encoding="utf-8") == "safe"
