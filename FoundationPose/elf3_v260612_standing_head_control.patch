+from types import SimpleNamespace
+
+import pytest
+
+from bxi_example_py_elf3 import head_control
+
+
+class _FakeNode:
+    pass
+
+
+_RosHeadControlNode = head_control._make_node_class(
+    _FakeNode,
+    None,
+    None,
+    None,
+    None,
+)
+
+
+def _endpoint(owner):
+    return SimpleNamespace(node_name=owner[0], node_namespace=owner[1])
+
+
+def _standing_graph():
+    node = object.__new__(_RosHeadControlNode)
+    node.full_body_standing_mode = True
+    node.feedback_topic = "hardware/actuator_states"
+    node.primary_command_topic = "hardware/actuators_cmds"
+    node.command_topic = "hardware/actuators_cmds_override"
+    node.state_machine_info_topic = "hardware/state_machine_info"
+    node.motion_command_topic = "motion_commands"
+    node.get_node_names_and_namespaces = lambda: list(
+        head_control.FULL_BODY_STANDING_NODES
+    )
+    node.get_publishers_info_by_topic = lambda topic: list(
+        {
+            "hardware/actuator_states": [
+                _endpoint(head_control.STANDING_HARDWARE_NODE)
+            ],
+            "hardware/actuators_cmds": [
+                _endpoint(head_control.STANDING_CONTROLLER_NODE)
+            ],
+            "hardware/state_machine_info": [
+                _endpoint(head_control.STANDING_CONTROLLER_NODE)
+            ],
+            "motion_commands": [_endpoint(head_control.REMOTE_CONTROLLER_NODE)],
+        }.get(topic, ())
+    )
+    node.get_subscriptions_info_by_topic = lambda topic: list(
+        {
+            "hardware/actuators_cmds": [
+                _endpoint(head_control.STANDING_HARDWARE_NODE)
+            ],
+            "hardware/actuators_cmds_override": [
+                _endpoint(head_control.STANDING_CONTROLLER_NODE)
+            ],
+            "motion_commands": [
+                _endpoint(head_control.STANDING_CONTROLLER_NODE)
+            ],
+        }.get(topic, ())
+    )
+    return node
+
+
+def test_valid_legacy_head_enabled_standing_graph_is_accepted():
+    ready, detail = _standing_graph()._hardware_graph_status()
+    assert ready is True
+    assert detail == "head-enabled full-body ROS graph verified"
+
+
+def test_current_head_disabled_node_is_rejected():
+    node = _standing_graph()
+    node.get_node_names_and_namespaces = lambda: [
+        ("hardware_elf3", "/"),
+        head_control.STANDING_CONTROLLER_NODE,
+        head_control.REMOTE_CONTROLLER_NODE,
+    ]
+    ready, detail = node._hardware_graph_status()
+    assert ready is False
+    assert "hardware_elf3_head" in detail
+
+
+def test_wrong_or_duplicate_override_endpoint_is_rejected():
+    node = _standing_graph()
+    original = node.get_subscriptions_info_by_topic
+    node.get_subscriptions_info_by_topic = lambda topic: (
+        [_endpoint(("unexpected", "/"))]
+        if topic == "hardware/actuators_cmds_override"
+        else original(topic)
+    )
+    ready, detail = node._hardware_graph_status()
+    assert ready is False
+    assert "override subscriber" in detail
+
+    node = _standing_graph()
+    original = node.get_subscriptions_info_by_topic
+    node.get_subscriptions_info_by_topic = lambda topic: (
+        [
+            _endpoint(head_control.STANDING_CONTROLLER_NODE),
+            _endpoint(head_control.STANDING_CONTROLLER_NODE),
+        ]
+        if topic == "hardware/actuators_cmds_override"
+        else original(topic)
+    )
+    ready, detail = node._hardware_graph_status()
+    assert ready is False
+    assert "override subscriber" in detail
+
+
+def test_client_feedback_rejects_duplicate_head_joint_names():
+    state = head_control.HeadCommandState(
+        yaw_limit=head_control.DEFAULT_YAW_LIMIT,
+        pitch_limit=head_control.DEFAULT_PITCH_LIMIT,
+        key_step=head_control.DEFAULT_STEP,
+        maximum_speed=head_control.DEFAULT_MAX_SPEED,
+        publish_rate=head_control.DEFAULT_PUBLISH_RATE,
+        feedback_timeout=head_control.DEFAULT_FEEDBACK_TIMEOUT,
+    )
+    with pytest.raises(ValueError, match="duplicate head joint"):
+        state.update_feedback(
+            ("head_z_joint", "head_z_joint", "head_y_joint"),
+            (0.0, 0.1, 0.0),
+            now=1.0,
+        )
