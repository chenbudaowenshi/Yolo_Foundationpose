+from threading import Lock
+from types import SimpleNamespace
+from types import ModuleType
+import importlib.util
+import sys
+import time
+
+from builtin_interfaces.msg import Time
+from communication.msg import ActuatorCmds
+import numpy as np
+import pytest
+
+# The controller's policy classes import these optional runtimes at module
+# load, but these tests never construct a policy or call inference.
+for _optional_module in ("onnx", "onnxruntime"):
+    if importlib.util.find_spec(_optional_module) is None:
+        sys.modules[_optional_module] = ModuleType(_optional_module)
+
+from bxi_example_py_elf3 import bxi_example_demo as demo
+from bxi_example_py_elf3.utils.head_override import (
+    HEAD_JOINT_NAMES,
+    HEAD_MAX_SPEED_RAD_PER_SEC,
+    HeadCommandOverride,
+)
+
+
+class _Publisher:
+    def __init__(self):
+        self.messages = []
+
+    def publish(self, message):
+        self.messages.append(message)
+
+
+class _Logger:
+    def __init__(self):
+        self.errors = []
+        self.infos = []
+
+    def error(self, message):
+        self.errors.append(message)
+
+    def info(self, message):
+        self.infos.append(message)
+
+
+class _Future:
+    def __init__(self, response):
+        self.response = response
+        self.cancelled = False
+
+    def done(self):
+        return True
+
+    def result(self):
+        return self.response
+
+    def cancel(self):
+        self.cancelled = True
+
+
+class _ResetClient:
+    def __init__(self, response):
+        self.response = response
+        self.requests = []
+
+    def service_is_ready(self):
+        return True
+
+    def call_async(self, request):
+        self.requests.append(request)
+        return _Future(self.response)
+
+
+def _controller_stub():
+    publisher = _Publisher()
+    logger = _Logger()
+    now = time.monotonic()
+    node = SimpleNamespace(
+        enable_head_control=True,
+        state=7,
+        state_name_by_id={7: "normal"},
+        step=2,
+        state_machine=SimpleNamespace(in_transition=False),
+        lock_in=Lock(),
+        head_feedback_received=True,
+        head_feedback_received_at=now,
+        head_feedback_timeout_sec=0.1,
+        head_feedback_position=np.asarray((0.2, -0.1), dtype=np.float32),
+        head_override=HeadCommandOverride(timeout_sec=0.2, release_sec=0.2),
+        _head_last_output_at=now - 0.02,
+        _last_actuator_layout_warning_at=float("-inf"),
+        dt=0.02,
+        qpos=np.zeros(demo.dof_num, dtype=np.float64),
+        qvel=np.zeros(demo.dof_num, dtype=np.float64),
+        act_pub=publisher,
+        get_clock=lambda: SimpleNamespace(
+            now=lambda: SimpleNamespace(to_msg=lambda: Time())
+        ),
+        get_logger=lambda: logger,
+    )
+    return node, publisher, logger
+
+
+def test_full_body_output_keeps_29_body_axes_and_leaves_idle_head_zero_gain():
+    node, publisher, _logger = _controller_stub()
+    body_position = np.linspace(-0.2, 0.2, demo.dof_num, dtype=np.float32)
+    body_kp = np.linspace(10.0, 20.0, demo.dof_num, dtype=np.float32)
+    body_kd = np.linspace(1.0, 2.0, demo.dof_num, dtype=np.float32)
+
+    demo.BxiExample.send_to_motor(node, body_position, body_kp, body_kd)
+
+    assert len(publisher.messages) == 1
+    message = publisher.messages[0]
+    assert tuple(message.actuators_name) == demo.joint_name + HEAD_JOINT_NAMES
+    assert len(message.pos) == len(message.vel) == len(message.torque) == 31
+    assert len(message.kp) == len(message.kd) == 31
+    assert message.pos[:29] == pytest.approx(body_position)
+    assert message.kp[:29] == pytest.approx(body_kp)
+    assert message.kd[:29] == pytest.approx(body_kd)
+    assert message.pos[-2:] == pytest.approx(node.head_feedback_position)
+    assert message.kp[-2:] == pytest.approx((0.0, 0.0))
+    assert message.kd[-2:] == pytest.approx((0.0, 0.0))
+    assert message.vel == pytest.approx(np.zeros(31))
+    assert message.torque == pytest.approx(np.zeros(31))
+
+
+def test_external_head_target_is_limited_server_side_before_31_axis_publish():
+    node, publisher, _logger = _controller_stub()
+    node.head_override.submit(
+        HEAD_JOINT_NAMES,
+        (1.0, -0.5),
+        (16.747, 16.747),
+        (1.066, 1.066),
+        received_at=time.monotonic(),
+    )
+
+    demo.BxiExample.send_to_motor(
+        node,
+        np.zeros(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+    )
+
+    maximum_increment = HEAD_MAX_SPEED_RAD_PER_SEC * node.dt
+    assert publisher.messages[0].pos[-2:] == pytest.approx(
+        (
+            node.head_feedback_position[0] + maximum_increment,
+            node.head_feedback_position[1] - maximum_increment,
+        )
+    )
+
+
+def test_bad_head_feedback_closes_head_gate_but_keeps_body_feedback_current():
+    node, _publisher, logger = _controller_stub()
+    node.qpos[:] = 7.0
+    node.qvel[:] = 8.0
+    message = SimpleNamespace(
+        name=demo.hardware_joint_name,
+        position=[0.0] * 29 + [float("nan"), 0.0],
+        velocity=[0.0] * 31,
+    )
+
+    demo.BxiExample.actuator_callback(node, message)
+
+    assert node.head_feedback_received is False
+    assert node.qpos == pytest.approx(np.zeros(29))
+    assert node.qvel == pytest.approx(np.zeros(29))
+    assert len(logger.errors) == 1
+
+
+def test_bad_feedback_consumes_old_override_before_feedback_recovers():
+    node, publisher, _logger = _controller_stub()
+    node.head_override.submit(
+        HEAD_JOINT_NAMES,
+        (0.4, -0.2),
+        (16.747, 16.747),
+        (1.066, 1.066),
+        received_at=time.monotonic(),
+    )
+    demo.BxiExample.send_to_motor(
+        node,
+        np.zeros(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+    )
+    publisher.messages.clear()
+    bad = SimpleNamespace(
+        name=demo.hardware_joint_name,
+        position=[0.0] * 30 + [float("nan")],
+        velocity=[0.0] * 31,
+    )
+    demo.BxiExample.actuator_callback(node, bad)
+
+    node.head_feedback_received = True
+    node.head_feedback_received_at = time.monotonic()
+    demo.BxiExample.send_to_motor(
+        node,
+        np.zeros(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+        np.ones(29, dtype=np.float32),
+    )
+
+    assert publisher.messages[0].kp[-2:] == pytest.approx((0.0, 0.0))
+    assert publisher.messages[0].kd[-2:] == pytest.approx((0.0, 0.0))
+
+
+def test_malformed_body_target_is_not_published():
+    node, publisher, logger = _controller_stub()
+    demo.BxiExample.send_to_motor(
+        node,
+        np.zeros(28, dtype=np.float32),
+        np.ones(28, dtype=np.float32),
+        np.ones(28, dtype=np.float32),
+    )
+
+    assert publisher.messages == []
+    assert len(logger.errors) == 1
+
+
+def test_reset_gate_advances_only_after_successful_service_response():
+    logger = _Logger()
+    client = _ResetClient(SimpleNamespace(is_success=True))
+    node = SimpleNamespace(
+        _reset_future=None,
+        _reset_future_step=None,
+        _reset_requested_at=0.0,
+        _reset_retry_at=0.0,
+        _reset_last_warning_at=float("-inf"),
