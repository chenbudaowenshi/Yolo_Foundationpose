+"""Fail-closed two-joint head override for the legacy ELF3 controller."""
+
+from __future__ import annotations
+
+import math
+import time
+from typing import Sequence, Tuple
+
+import numpy as np
+
+
+HEAD_JOINT_NAMES = ("head_z_joint", "head_y_joint")
+HEAD_POSITION_LIMITS = np.asarray((1.57, 0.785), dtype=np.float32)
+HEAD_DEFAULT_POSITION = np.zeros(2, dtype=np.float32)
+HEAD_DEFAULT_KP = np.asarray((16.747, 16.747), dtype=np.float32)
+HEAD_DEFAULT_KD = np.asarray((1.066, 1.066), dtype=np.float32)
+HEAD_MAX_KP = float(HEAD_DEFAULT_KP[0])
+HEAD_MAX_KD = float(HEAD_DEFAULT_KD[0])
+HEAD_MAX_SPEED_RAD_PER_SEC = math.radians(10.0)
+HEAD_FEEDBACK_LIMIT_TOLERANCE = 1.0e-3
+LEGACY_BODY_DOF_NUM = 29
+
+
+def _feedback_sequences(
+    names: Sequence[str],
+    position: object,
+    velocity: object,
+) -> tuple[tuple[str, ...], tuple[object, ...], tuple[object, ...]]:
+    feedback_names = tuple(names)
+    try:
+        positions = tuple(position)
+        velocities = tuple(velocity)
+    except TypeError as error:
+        raise ValueError("actuator feedback position/velocity must be sequences") from error
+    if len(positions) != len(feedback_names) or len(velocities) != len(
+        feedback_names
+    ):
+        raise ValueError(
+            "actuator feedback name/position/velocity lengths differ: "
+            "{}/{}/{}".format(
+                len(feedback_names),
+                len(positions),
+                len(velocities),
+            )
+        )
+    return feedback_names, positions, velocities
+
+
+def _unique_indices(
+    feedback_names: tuple[str, ...],
+    required_names: Sequence[str],
+    label: str,
+) -> np.ndarray:
+    indices = []
+    for name in required_names:
+        matches = tuple(
+            index
+            for index, feedback_name in enumerate(feedback_names)
+            if feedback_name == name
+        )
+        if not matches:
+            raise ValueError(
+                "actuator feedback is missing {} joint: {}".format(label, name)
+            )
+        if len(matches) != 1:
+            raise ValueError(
+                "actuator feedback contains duplicate {} joint: {}".format(
+                    label, name
+                )
+            )
+        indices.append(matches[0])
+    return np.asarray(indices, dtype=np.intp)
+
+
+def extract_body_feedback(
+    names: Sequence[str],
+    position: object,
+    velocity: object,
+    body_names: Sequence[str],
+) -> tuple[np.ndarray, np.ndarray]:
+    """Extract a finite named body sample independently of head health."""
+    feedback_names, positions, velocities = _feedback_sequences(
+        names, position, velocity
+    )
+    body_joint_names = tuple(body_names)
+    if len(body_joint_names) != LEGACY_BODY_DOF_NUM:
+        raise ValueError(
+            "legacy body feedback layout must contain exactly {} joints".format(
+                LEGACY_BODY_DOF_NUM
+            )
+        )
+    body_indices = _unique_indices(feedback_names, body_joint_names, "body")
+    try:
+        body_position = np.asarray(
+            [positions[index] for index in body_indices], dtype=np.float64
+        )
+        body_velocity = np.asarray(
+            [velocities[index] for index in body_indices], dtype=np.float64
+        )
+    except (TypeError, ValueError) as error:
+        raise ValueError("body actuator feedback must be numeric") from error
+    if not (
+        np.all(np.isfinite(body_position))
+        and np.all(np.isfinite(body_velocity))
+    ):
+        raise ValueError("body actuator feedback contains NaN or Inf")
+    return body_position.copy(), body_velocity.copy()
+
+
+def extract_head_feedback(
+    names: Sequence[str],
+    position: object,
+    velocity: object,
+) -> np.ndarray:
+    """Extract a finite, mechanically bounded two-axis head sample."""
+    feedback_names, positions, velocities = _feedback_sequences(
+        names, position, velocity
+    )
+    head_indices = _unique_indices(feedback_names, HEAD_JOINT_NAMES, "head")
+    try:
+        head_position = np.asarray(
+            [positions[index] for index in head_indices], dtype=np.float64
+        )
+        head_velocity = np.asarray(
+            [velocities[index] for index in head_indices], dtype=np.float64
+        )
+    except (TypeError, ValueError) as error:
+        raise ValueError("head actuator feedback must be numeric") from error
+    if not np.all(np.isfinite(head_position)) or not np.all(
+        np.isfinite(head_velocity)
+    ):
+        raise ValueError("head actuator feedback contains NaN or Inf")
+    if np.any(
+        np.abs(head_position)
+        > HEAD_POSITION_LIMITS.astype(np.float64)
+        + HEAD_FEEDBACK_LIMIT_TOLERANCE
+    ):
+        raise ValueError("head feedback exceeds the ELF3 mechanical limit")
+
+    return head_position.copy()
+
+
+def limit_head_position_from_feedback(
+    target: object,
+    feedback: object,
+    *,
+    maximum_speed: float,
+    elapsed: float,
+) -> np.ndarray:
+    """Apply the server-side speed limit relative to measured head position."""
+    target_array = _finite_vector("target pos", target)
+    feedback_array = _finite_vector("feedback pos", feedback)
+    speed = float(maximum_speed)
+    period = float(elapsed)
+    if not math.isfinite(speed) or speed <= 0.0:
+        raise ValueError("head maximum speed must be positive and finite")
+    if not math.isfinite(period) or period < 0.0:
+        raise ValueError("head command elapsed time must be finite and non-negative")
+    maximum_increment = speed * period
+    limited = feedback_array + np.clip(
+        target_array - feedback_array,
+        -maximum_increment,
+        maximum_increment,
+    )
+    return np.clip(limited, -HEAD_POSITION_LIMITS, HEAD_POSITION_LIMITS)
+
+
+def head_override_permitted(
+    *,
+    reset_step: int,
+    state_name: str,
+    in_transition: bool,
+    feedback_received: bool,
+    feedback_received_at: float,
+    now: float,
+    feedback_timeout_sec: float,
+) -> bool:
+    """Gate the head whenever reset, zero-torque, or feedback is unsafe."""
+    timestamp = float(now)
+    received_at = float(feedback_received_at)
+    timeout = float(feedback_timeout_sec)
+    if not math.isfinite(timestamp) or not math.isfinite(timeout) or timeout <= 0.0:
+        raise ValueError("head feedback gate times must be finite and positive")
+    feedback_age = timestamp - received_at
+    return bool(
+        reset_step == 2
+        and state_name != "zero_torque"
+        and not in_transition
+        and feedback_received
+        and math.isfinite(received_at)
+        and 0.0 <= feedback_age <= timeout
+    )
+
+
+def append_head_command(
+    body_position: object,
+    body_kp: object,
+    body_kd: object,
+    head_position: object,
+    head_kp: object,
+    head_kd: object,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Append two validated head fields without changing any body element."""
+    body_arrays = tuple(
+        np.asarray(values, dtype=np.float32) for values in (
+            body_position,
+            body_kp,
+            body_kd,
+        )
+    )
+    if any(array.ndim != 1 for array in body_arrays):
+        raise ValueError("body command fields must be one-dimensional")
+    if len({array.shape for array in body_arrays}) != 1:
+        raise ValueError("body command fields must have matching shapes")
+    if body_arrays[0].shape != (LEGACY_BODY_DOF_NUM,):
+        raise ValueError(
+            "legacy body command fields must contain exactly {} joints".format(
+                LEGACY_BODY_DOF_NUM
+            )
+        )
+    if not all(np.all(np.isfinite(array)) for array in body_arrays):
+        raise ValueError("body command fields must contain only finite values")
+
+    return (
+        np.concatenate((body_arrays[0], _finite_vector("pos", head_position))),
+        np.concatenate((body_arrays[1], _finite_vector("kp", head_kp))),
+        np.concatenate((body_arrays[2], _finite_vector("kd", head_kd))),
+    )
+
+
+def _finite_vector(
+    field: str,
+    values: object,
+    *,
+    allow_empty_as_zero: bool = False,
+) -> np.ndarray:
+    array = np.asarray(values, dtype=np.float32)
+    if allow_empty_as_zero and array.shape == (0,):
+        return np.zeros(2, dtype=np.float32)
+    if array.shape != (2,):
+        raise ValueError(
+            f"head override {field} has shape {array.shape}, expected (2,)"
+        )
+    if not np.all(np.isfinite(array)):
+        raise ValueError(
+            f"head override {field} must contain only finite values"
+        )
+    return array.copy()
+
+
+class HeadCommandOverride:
+    """Validate, time-limit and smoothly release one two-axis command."""
+
+    def __init__(self, *, timeout_sec: float = 0.2, release_sec: float = 0.2):
+        self.timeout_sec = float(timeout_sec)
+        self.release_sec = float(release_sec)
+        if not math.isfinite(self.timeout_sec) or self.timeout_sec <= 0.0:
+            raise ValueError("head override timeout must be positive and finite")
+        if not math.isfinite(self.release_sec) or self.release_sec < 0.0:
+            raise ValueError(
+                "head override release duration must be finite and non-negative"
+            )
+
+        self._position = HEAD_DEFAULT_POSITION.copy()
+        self._kp = HEAD_DEFAULT_KP.copy()
+        self._kd = HEAD_DEFAULT_KD.copy()
+        self._received_at = float("-inf")
+        self._command_active = False
+        self._was_applied = False
+        self._release_active = False
+        self._release_started_at = 0.0
+        self._release_position = HEAD_DEFAULT_POSITION.copy()
+        self._release_kp = HEAD_DEFAULT_KP.copy()
+        self._release_kd = HEAD_DEFAULT_KD.copy()
+        self._last_position = HEAD_DEFAULT_POSITION.copy()
+        self._last_kp = HEAD_DEFAULT_KP.copy()
+        self._last_kd = HEAD_DEFAULT_KD.copy()
+
+    def submit(
+        self,
+        names: Sequence[str],
+        position: object,
+        kp: object,
+        kd: object,
+        *,
+        velocity: object = (),
+        torque: object = (),
+        received_at: float | None = None,
+    ) -> Tuple[str, str]:
+        command_names = tuple(names)
+        if len(command_names) != 2 or set(command_names) != set(HEAD_JOINT_NAMES):
+            raise ValueError(
+                "head override must contain exactly head_z_joint and head_y_joint"
+            )
+        if len(set(command_names)) != len(command_names):
+            raise ValueError("head override contains duplicate joints")
+
+        submitted_position = _finite_vector("pos", position)
+        submitted_kp = _finite_vector("kp", kp)
+        submitted_kd = _finite_vector("kd", kd)
+        submitted_velocity = _finite_vector(
+            "vel", velocity, allow_empty_as_zero=True
+        )
+        submitted_torque = _finite_vector(
+            "torque", torque, allow_empty_as_zero=True
+        )
+
+        indices = tuple(command_names.index(name) for name in HEAD_JOINT_NAMES)
+        submitted_position = submitted_position[list(indices)]
+        submitted_kp = submitted_kp[list(indices)]
+        submitted_kd = submitted_kd[list(indices)]
+        submitted_velocity = submitted_velocity[list(indices)]
+        submitted_torque = submitted_torque[list(indices)]
+
+        if np.any(np.abs(submitted_position) > HEAD_POSITION_LIMITS):
+            raise ValueError("head override position exceeds the mechanical limit")
+        if np.any(submitted_kp < 0.0) or np.any(submitted_kp > HEAD_MAX_KP):
+            raise ValueError(f"head override kp must be within [0, {HEAD_MAX_KP}]")
+        if np.any(submitted_kd < 0.0) or np.any(submitted_kd > HEAD_MAX_KD):
+            raise ValueError(f"head override kd must be within [0, {HEAD_MAX_KD}]")
+        if np.any(submitted_velocity != 0.0):
+            raise ValueError("head override velocity feed-forward must be zero")
+        if np.any(submitted_torque != 0.0):
+            raise ValueError("head override torque feed-forward must be zero")
+
+        timestamp = time.monotonic() if received_at is None else float(received_at)
+        if not math.isfinite(timestamp):
+            raise ValueError("head override receive time must be finite")
+
+        self._position[:] = submitted_position
+        self._kp[:] = submitted_kp
+        self._kd[:] = submitted_kd
+        self._received_at = timestamp
+        self._command_active = True
+        self._release_active = False
+        return HEAD_JOINT_NAMES
+
+    def clear(self) -> None:
+        """Request a normal release that may use the configured blend."""
+        self._command_active = False
+
+    def cancel(self) -> None:
+        """Immediately discard command and release history for a safety gate."""
+        self._command_active = False
+        self._was_applied = False
+        self._release_active = False
+        self._received_at = float("-inf")
+
+    def apply(
+        self,
+        base_position: object,
+        base_kp: object,
+        base_kd: object,
+        *,
+        now: float | None = None,
+        permitted: bool = True,
+    ) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+        timestamp = time.monotonic() if now is None else float(now)
+        if not math.isfinite(timestamp):
+            raise ValueError("head override apply time must be finite")
+        base_position_array = _finite_vector("base pos", base_position)
+        base_kp_array = _finite_vector("base kp", base_kp)
+        base_kd_array = _finite_vector("base kd", base_kd)
+
+        command_age = timestamp - self._received_at
+        fresh = self._command_active and 0.0 <= command_age <= self.timeout_sec
+        if fresh and permitted:
+            self._last_position[:] = self._position
+            self._last_kp[:] = self._kp
+            self._last_kd[:] = self._kd
+            self._was_applied = True
+            self._release_active = False
+            return self._position.copy(), self._kp.copy(), self._kd.copy()
+
+        if not fresh:
+            self._command_active = False
+
+        if not permitted:
+            # Consume a command while the safety gate is closed so an old
+            # sample cannot reactivate when feedback/state health recovers.
+            self.cancel()
+            return base_position_array, base_kp_array, base_kd_array
+
+        if self._was_applied:
+            self._release_position[:] = self._last_position
+            self._release_kp[:] = self._last_kp
+            self._release_kd[:] = self._last_kd
+            self._release_started_at = timestamp
+            self._release_active = self.release_sec > 0.0
+            self._was_applied = False
+
+        if not self._release_active:
+            return base_position_array, base_kp_array, base_kd_array
+
+        elapsed = max(0.0, timestamp - self._release_started_at)
+        if elapsed >= self.release_sec:
+            self._release_active = False
+            return base_position_array, base_kp_array, base_kd_array
+
+        alpha = elapsed / self.release_sec
+        return (
+            self._release_position
+            + alpha * (base_position_array - self._release_position),
