+    def _write_text(self, path: str, text: str) -> Optional[str]:
+        try:
+            self._write_graph_file(path, text)
+            return path
+        except OSError as error:
+            first_error = error
+
+        basename = os.path.basename(path) or "state_machine.graph"
+        try:
+            fallback = self._write_process_graph_file(basename, text)
+        except OSError as fallback_error:
+            self._report_graph_diagnostic(
+                GraphDiagnostic(
+                    "warning",
+                    "state graph export skipped: cannot write {} ({}) or a "
+                    "secure process-scoped temporary file ({})".format(
+                        path,
+                        first_error,
+                        fallback_error,
+                    ),
+                )
+            )
+            return None
+
+        self._report_graph_diagnostic(
+            GraphDiagnostic(
+                "warning",
+                "state graph export could not write {} ({}); wrote {} instead".format(
+                    path,
+                    first_error,
+                    fallback,
+                ),
+            )
+        )
+        return fallback
+
+    @staticmethod
+    def _write_graph_file(path: str, text: str) -> None:
+        directory = os.path.dirname(path) or "."
+        os.makedirs(directory, exist_ok=True)
+        basename = os.path.basename(path) or "state_machine.graph"
+        descriptor, temporary_path = tempfile.mkstemp(
+            prefix=".{}.".format(basename),
+            dir=directory,
+            text=True,
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as output_file:
+                output_file.write(text)
+            os.replace(temporary_path, path)
+        except BaseException:
+            try:
+                os.unlink(temporary_path)
+            except FileNotFoundError:
+                pass
+            raise
+
+    @staticmethod
+    def _write_process_graph_file(basename: str, text: str) -> str:
+        stem, suffix = os.path.splitext(basename)
+        descriptor, path = tempfile.mkstemp(
+            prefix="{}.uid{}.pid{}.".format(stem, os.geteuid(), os.getpid()),
+            suffix=suffix,
+            dir=tempfile.gettempdir(),
+            text=True,
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as output_file:
+                output_file.write(text)
+        except BaseException:
+            try:
+                os.unlink(path)
+            except FileNotFoundError:
+                pass
+            raise
+        return path
