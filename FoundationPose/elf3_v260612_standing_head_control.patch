+
+def test_reset_gate_retries_instead_of_accepting_rejected_response():
+    logger = _Logger()
+    client = _ResetClient(SimpleNamespace(is_success=False))
+    node = SimpleNamespace(
+        _reset_future=None,
+        _reset_future_step=None,
+        _reset_requested_at=0.0,
+        _reset_retry_at=0.0,
+        _reset_last_warning_at=float("-inf"),
+        rest_srv=client,
+        get_logger=lambda: logger,
